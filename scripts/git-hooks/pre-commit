#!/bin/sh
# 提交前拦截不应入库的文件，避免大体积依赖与构建产物混入历史。

staged=$(git diff --cached --name-only --diff-filter=ACMR)

[ -z "$staged" ] && exit 0

bad=$(printf '%s\n' "$staged" | grep -E \
  '(^|/)(\.DS_Store|Thumbs\.db)$|(^|/)(node_modules|dist|release|\.npm-cache|test-results|playwright-report|coverage|artifacts)/|\.jar$|(^|/)\.env(\.local)?$')

if [ -n "$bad" ]; then
  echo "✗ 以下文件不应提交（已在 .gitignore 中声明）：" >&2
  printf '%s\n' "$bad" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  撤销暂存：git restore --staged <文件>" >&2
  exit 1
fi

# 大文件只提示、不阻断：文档截图等合理情况仍可提交
large=$(printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt 2097152 ]; then
    printf '%s (%s KB)\n' "$f" $((size / 1024))
  fi
done)

if [ -n "$large" ]; then
  echo "⚠ 本次提交含大于 2MB 的文件，请确认是否必要：" >&2
  printf '%s\n' "$large" | sed 's/^/    /' >&2
fi

exit 0
